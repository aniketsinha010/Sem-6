Assignment 5(a): Construct an LL(1) parser


Grammar : E -> T E'\nE' -> + T E' | 蔚\nT -> F T'\nT' -> * F T' | 蔚\nF -> ( E ) | i

#include <stdio.h>
#include <string.h>
char table[5][6][10] = {
    /* columns: i + * ( ) $ */
        {"TQ", "", "", "TQ", "", ""},
        {"", "+TQ", "", "", "e", "e"},
        {"FR", "", "", "FR", "", ""},
        {"", "e", "*FR", "", "e", "e"},
        {"i", "", "", "(E)", "", ""}
};
/* Rows: E, Q(E'), T, R(T'), F. E denotes E', T denotes T'. */
    int row(char c) {
    if (c == 'E') return 0;
    if (c == 'Q') return 1;
    if (c == 'T') return 2;
    if (c == 'R') return 3;
    if (c == 'F') return 4;
    return -1;
}
int col(char c) {
    if (c == 'i') return 0;
    if (c == '+') return 1;
    if (c == '*') return 2;
    if (c == '(') return 3;
    if (c == ')') return 4;
    if (c == '$') return 5;
    return -1;
}
int terminal(char c) {
    return c == 'i' || c == '+' || c == '*' ||
        c == '(' || c == ')' || c == '$';
}
int main(void) {
    char input[200], stack[300];
    int top = 0, ip = 0, r, c, k;
    printf("Enter expression (use i for identifier): ");
    if (scanf("%199s", input) != 1) return 1;
    strcat(input, "$");
    stack[top++] = '$';
    stack[top++] = 'E';
    while (top > 0) {
        char x = stack[top - 1], a = input[ip];
        if (x == '$' && a == '$') {
            puts("String accepted by LL(1) parser.");
            return 0;
        }
        if (terminal(x)) {
            if (x == a) { top--; ip++; }
            else { puts("String rejected."); return 0; }
        } else {
            r = row(x); c = col(a);
            if (r < 0 || c < 0 || table[r][c][0] == '\0') {
                puts("String rejected."); return 0;
            }
            top--;
            if (strcmp(table[r][c], "e") != 0) {
                /* Push production in reverse order. */
                    for (k = (int)strlen(table[r][c]) - 1; k >= 0; k--) {
                    char sym = table[r][c][k];
                    /* Q and R represent E-prime and T-prime. */
                        stack[top++] = sym;
                }
            }
        }
    }
    puts("String rejected.");
    return 0;
}

