Assignment 5(b): Construct a recursive descent parser


Grammar : E -> T E'\nE' -> + T E' | 蔚\nT -> F T'\nT' -> * F T' | 蔚\nF -> ( E ) | i

#include <stdio.h>
#include <string.h>
char s[200];
int pos = 0, error = 0;
void E(void);
void T(void);
void F(void);
void match(char c) {
    if (s[pos] == c) pos++;
    else error = 1;
}
void E(void) {
    T();
    while (s[pos] == '+') {
        match('+');
        T();
    }
}
void T(void) {
    F();
    while (s[pos] == '*') {
        match('*');
        F();
    }
}
void F(void) {
    if (s[pos] == 'i') {
        match('i');
    } else if (s[pos] == '(') {
        match('(');
        E();
        match(')');
    } else {
        error = 1;
    }
}
int main(void) {
    printf("Enter expression (use i for identifier): ");
    if (scanf("%199s", s) != 1) return 1;
    E();
    if (error || s[pos] != '\0')
        puts("String rejected by recursive descent parser.");
    else
        puts("String accepted by recursive descent parser.");
    return 0;
}


