    return isalnum((unsigned char)c) || c == '_';
}
int main(void) {
    char src[5000], word[100];
    int c, i = 0, loopPending = 0, loopDepth[500], depth = 0;
    int bad = 0, foundBreak = 0;
    printf("Enter C-like code (finish with a line containing END):\n");
    while (fgets(src + i, sizeof(src) - (size_t)i, stdin)) {
        if (strcmp(src + i, "END\n") == 0 || strcmp(src + i, "END") == 0) {
            src[i] = '\0'; break;
        }
        i += (int)strlen(src + i);
        if (i >= (int)sizeof(src) - 2) break;
    }
    i = 0;
    while (src[i]) {
        if (isalpha((unsigned char)src[i]) || src[i] == '_') {
            int j = 0;
            while (is_word_char(src[i])) {
                if (j < 98) word[j++] = src[i];
                i++;
            }
            word[j] = '\0';
            if (strcmp(word, "for") == 0 || strcmp(word, "while") == 0 ||
                strcmp(word, "do") == 0) loopPending = 1;
            if (strcmp(word, "break") == 0) {
                foundBreak = 1;
                if (depth == 0) {
                    printf("Error: break used outside a loop.\n");
                    bad = 1;
                } else {
                    printf("break used inside a loop.\n");
                }
            }
        } else if (src[i] == '{') {
            depth++;
            loopDepth[depth] = loopPending;
            loopPending = 0;
            i++;
        } else if (src[i] == '}') {
            if (depth > 0) depth--;
            i++;
        } else {
            i++;
        }
    }
    if (!foundBreak) puts("No break statement found.");
    else if (!bad) puts("All break statements are inside loop blocks.");
    return 0;
}


