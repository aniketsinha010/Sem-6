Assignment 7: Check whether values match their declared datatypes


#include <stdio.h>
#include <string.h>
#include <ctype.h>
int is_integer(const char *s) {
    int i = 0;
    if (s[i] == '+' || s[i] == '-') i++;
    if (!isdigit((unsigned char)s[i])) return 0;
    for (; s[i]; i++) if (!isdigit((unsigned char)s[i])) return 0;
    return 1;
}
int is_number(const char *s) {
    int i = 0, digits = 0, dot = 0;
    if (s[i] == '+' || s[i] == '-') i++;
    for (; s[i] && s[i] != 'e' && s[i] != 'E'; i++) {
        if (isdigit((unsigned char)s[i])) digits++;
        else if (s[i] == '.' && !dot) dot = 1;
        else return 0;
    }
    if (!digits) return 0;
    if (s[i] == 'e' || s[i] == 'E') {
        int expdigits = 0;
        i++;
        if (s[i] == '+' || s[i] == '-') i++;
        for (; s[i]; i++) {
            if (!isdigit((unsigned char)s[i])) return 0;
            expdigits++;
        }
        if (!expdigits) return 0;
    }
    return s[i] == '\0';
}
int main(void) {
    char type[20], value[100];
    int valid = 0;
    printf("Enter datatype (int/float/double/char): ");
    scanf("%19s", type);
    printf("Enter value/literal: ");
    scanf("%99s", value);
    if (strcmp(type, "int") == 0) valid = is_integer(value);
    else if (strcmp(type, "float") == 0 || strcmp(type, "double") == 0)
        valid = is_number(value);
    else if (strcmp(type, "char") == 0)
        valid = strlen(value) == 3 && value[0] == '\'' && value[2] == '\'';
    else {
        puts("Unsupported datatype.");
        return 0;
    }
    if (valid) puts("Value is compatible with the declared datatype.");
    else puts("Value is not compatible with the declared datatype.");
    return 0;
}


