Assignment 12: Generate postfix representation


#include <stdio.h>
#include <string.h>
#include <ctype.h>
int precedence(char c) {
    if (c == '*' || c == '/') return 2;
    if (c == '+' || c == '-') return 1;
    return 0;
}
int main(void) {
    char infix[300], postfix[300], stack[300];
    int top = -1, i, j = 0;
    printf("Enter infix expression: ");
    if (!fgets(infix, sizeof(infix), stdin)) return 1;
    for (i = 0; infix[i] && infix[i] != '\n'; i++) {
        char c = infix[i];
        if (isspace((unsigned char)c)) continue;
        if (isalnum((unsigned char)c) || c == '_') {
            postfix[j++] = c;
        } else if (c == '(') {
            stack[++top] = c;
        } else if (c == ')') {
            while (top >= 0 && stack[top] != '(')
                postfix[j++] = stack[top--];
            if (top < 0) {
                puts("Mismatched parentheses."); return 0;
            }
            top--;
        } else if (c == '+' || c == '-' || c == '*' || c == '/') {
            while (top >= 0 && stack[top] != '(' &&
                precedence(stack[top]) >= precedence(c))
            postfix[j++] = stack[top--];
            stack[++top] = c;
        } else {
            printf("Invalid character: %c\n", c);
            return 0;
        }
    }
    while (top >= 0) {
        if (stack[top] == '(') {
            puts("Mismatched parentheses."); return 0;
        }
        postfix[j++] = stack[top--];
    }
    postfix[j] = '\0';
    printf("Postfix expression: %s\n", postfix);
    return 0;
}


