Assignment 2: Recognize strings under a, a*b+, and abb


#include <stdio.h>
#include <string.h>
int is_a_star_b_plus(const char *s) {
    int i = 0, count_b = 0;
    while (s[i] == 'a') i++;
    while (s[i] == 'b') {
        count_b++;
        i++;
    }
    return s[i] == '\0' && count_b > 0;
}
int main(void) {
    char s[200];
    printf("Enter a string: ");
    if (scanf("%199s", s) != 1) return 1;
    if (strcmp(s, "a") == 0)
        printf("Accepted: matches the pattern a.\n");
    else if (is_a_star_b_plus(s))
        printf("Accepted: matches the pattern a*b+.\n");
    else if (strcmp(s, "abb") == 0)
        printf("Accepted: matches the pattern abb.\n");
    else
        printf("Rejected: does not match any specified pattern.\n");
    return 0;
}


