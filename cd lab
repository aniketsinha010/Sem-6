

Assignment 1: Identify whether a given line is a comment or not


#include <stdio.h>
#include <string.h>
#include <ctype.h>
int main(void) {
    char line[500];
    int start = 0, end;
    printf("Enter a line: ");
    if (fgets(line, sizeof(line), stdin) == NULL) return 1;
    while (line[start] && isspace((unsigned char)line[start]))
        start++;
    end = (int)strlen(line) - 1;
    while (end >= start && isspace((unsigned char)line[end]))
        end--;
    if (start + 1 <= end && line[start] == '/' && line[start + 1] == '/') {
        printf("It is a single-line comment.\n");
    } else if (start + 1 <= end && line[start] == '/' &&
        line[start + 1] == '*' && end - 1 >= start &&
        line[end - 1] == '*' && line[end] == '/') {
        printf("It is a block-comment line.\n");
    } else {
        printf("It is not a comment.\n");
    }
    return 0;
}


